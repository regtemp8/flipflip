{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "target": "es2023",
    "module": "commonjs",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "rootDir": "./src",
    "outDir": "dist",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "jsx": "react",
    "paths": {
      "*": ["./node_modules/*"]
    }
  },
  "include": ["./src/**/*"]
}
