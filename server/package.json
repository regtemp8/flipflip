{
  "name": "server",
  "version": "4.0.0-beta5",
  "main": "index.js",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@types/node": "^22.5.5",
    "@types/passport": "^1.0.16",
    "better-sqlite3": "^11.3.0",
    "connect-sqlite3": "^0.9.15",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-session": "^1.18.0",
    "flipflip-common": "link:./../common",
    "font-list": "^1.5.1",
    "generate-password": "^1.7.1",
    "kysely": "^0.27.4",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "passport-unique-token": "^3.0.0",
    "system-font-families": "^0.6.0",
    "typescript": "^5.6.2",
    "unique-username-generator": "^1.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/connect-sqlite3": "^0",
    "@types/cookie-parser": "^1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1",
    "@types/passport-local": "^1",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "@yao-pkg/pkg": "^5.15.0",
    "eslint": "^8.0.1",
    "eslint-plugin-import": "^2.25.0",
    "kysely-codegen": "^0.16.8",
    "prettier": "^3.2.4",
    "ts-node": "^10.9.2"
  },
  "scripts": {
    "dev": "NODE_ENV=development && yarn tsc && node --env-file=.env ./bin/server.js",
    "lint": "eslint --fix --ignore-path .eslintignore --ext .js,.ts,.tsx .",
    "test:lint": "eslint --ignore-path .eslintignore --ext .js,.ts,.tsx .",
    "format": "prettier --ignore-path .eslintignore --write \"**/*.+(js|ts|tsx|json)\"",
    "test:format": "prettier --ignore-path .eslintignore --list-different \"**/*.+(js|ts|tsx|json)\"",
    "db:codegen-help": "kysely-codegen --help",
    "db:codegen": "kysely-codegen --camel-case --dialect sqlite --env-file .env --out-file ./src/db/types/generated.d.ts",
    "db:verify": "yarn db:codegen --verify",
    "package": "cd ../client && yarn install && yarn build && cd ../server && rm -rf bin && yarn tsc && mv ../client/dist bin/public/ && pkg --debug ."
  },
  "bin": "bin/server.js",
  "pkg": {
    "scripts": "bin/**/*.js",
    "assets": "bin/public/**/*",
    "targets": [
      "node20-linux-x64"
    ],
    "outputPath": "dist"
  },
  "packageManager": "yarn@4.5.0"
}
