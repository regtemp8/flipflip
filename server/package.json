{
  "name": "server",
  "version": "4.0.0-beta5",
  "main": "index.js",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "better-sqlite3": "^11.3.0",
    "connect-sqlite3": "^0.9.15",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-async-errors": "^3.1.1",
    "express-session": "^1.18.0",
    "fast-redact": "^3.5.0",
    "ffprobe": "^1.1.2",
    "flipflip-common": "link:./../common",
    "get-folder-size": "^2.0.1",
    "gif-info": "^1.0.1",
    "http-proxy": "^1.18.1",
    "image-size": "^2.0.2",
    "imgur": "^2.5.0",
    "jsdom": "^26.1.0",
    "kysely": "^0.27.4",
    "mime-types": "^3.0.1",
    "moment": "^2.30.1",
    "music-metadata": "^7.14.0",
    "node-schedule": "^2.1.1",
    "node-worker-threads-pool": "^1.5.1",
    "passport": "^0.7.0",
    "passport-custom": "^1.1.1",
    "recursive-readdir": "^2.2.3",
    "snoowrap": "^1.23.0",
    "string-template": "^1.0.0",
    "tumblr.js": "^5.0.1",
    "typescript": "^5.6.2",
    "winston": "^3.15.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/connect-sqlite3": "^0",
    "@types/cookie-parser": "^1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1",
    "@types/fast-redact": "^3",
    "@types/ffprobe": "^1.1.8",
    "@types/get-folder-size": "^2.0.0",
    "@types/http-proxy": "^1",
    "@types/jsdom": "^21.1.7",
    "@types/mime-types": "^3",
    "@types/node": "^22.13.14",
    "@types/node-schedule": "^2",
    "@types/passport": "^1.0.16",
    "@types/recursive-readdir": "^2",
    "@types/string-template": "^1",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "@yao-pkg/pkg": "^6.6.0",
    "eslint": "^8.0.1",
    "eslint-plugin-import": "^2.25.0",
    "kysely-codegen": "^0.17.0",
    "prettier": "^3.2.4"
  },
  "scripts": {
    "build": "yarn tsc",
    "dev": "yarn build && node --env-file=.env ./bin/server.js",
    "prod": "yarn build -p tsconfig.production.json",
    "test": "yarn test:prepare && yarn build && node --env-file=./tests/config/.env ./bin/server.js",
    "test:prepare": "yarn build -p tsconfig.testing.json && node ./tests/bin/tests/config/create-test-env.js",
    "lint": "eslint --fix --ignore-path .eslintignore --ext .js,.ts,.tsx .",
    "test:lint": "eslint --ignore-path .eslintignore --ext .js,.ts,.tsx .",
    "format": "prettier --ignore-path .eslintignore --write \"**/*.+(js|ts|tsx|json)\"",
    "test:format": "prettier --ignore-path .eslintignore --list-different \"**/*.+(js|ts|tsx|json)\"",
    "db:codegen-help": "kysely-codegen --help",
    "db:codegen": "kysely-codegen --camel-case --dialect sqlite --env-file .env --out-file ./src/db/types/generated.ts",
    "db:verify": "yarn db:codegen --verify"
  },
  "bin": "bin/server.js",
  "pkg": {
    "scripts": "bin/**/*.js",
    "assets": [
      "bin/public/**/*",
      "node_modules/@ffprobe-installer/**/ffprobe",
      "node_modules/@ffprobe-installer/**/ffprobe.exe",
      "node_modules/@ffprobe-installer/**/package.json",
      "node_modules/better-sqlite3/build/Release/better_sqlite3.node"
    ],
    "outputPath": "dist"
  },
  "packageManager": "yarn@4.6.0"
}
